{
    "name": "phox/composable-jev",
    "description": "A library to chain Jev calls, for the deranged and enlightened",
    "keywords": [
        "typesafe",
        "jev",
        "system-one",
        "llm",
        "graph",
        "chaining"
    ],
    "homepage": "https://fox-islam.github.io/composable-jev/",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Fox Islam",
            "email": "foxislam@outlook.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "phox/typesafe-sdk-php": "^0.4.2"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "laravel/pint": "^1.18",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Phox\\ComposableJev\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "php/tests/"
        }
    },
    "scripts": {
        "test": "pest --test-directory=php/tests",
        "lint": "pint --test",
        "fixtures": "php php/bin/fixtures.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
